; The world client (docs/v3/design.html §12.1): draws a book's world from the render protocol (engine/render/protocol.mjs).
config_version=5

[application]

config/name="Novel World"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1500
window/size/viewport_height=950

[rendering]

renderer/rendering_method="mobile"

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.0235, 0.047, 0.0706, 1)
